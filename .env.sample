# Public site domain (Porkbun). Set before build/deploy.
# socialskills.ninja is the chosen canonical — DNS-confirmed unregistered.
NEXT_PUBLIC_SITE_URL=https://socialskills.ninja

# Optional: enable live caption improvement (one of these).
# OPENAI_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=

# REQUIRED to connect any real platform account: 32-byte master key used to
# AES-256-GCM encrypt stored credentials (e.g. Bluesky app passwords) at rest
# in data/db.json. Generate one and export it in the shell that runs dev/deploy:
#   openssl rand -hex 32
# Losing it makes stored credentials unrecoverable by design.
SS_MASTER_KEY=
